{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "laravel-boost@claude-plugins-official": false
  },
  "skillOverrides": {
    "swift-codable": "off",
    "swiftui-expert-skill": "off",
    "xcode-project-setup": "off",
    "next": "off",
    "nextjs-developer": "off",
    "nextjs-cache-architecture": "off",
    "next-cache-components-adoption": "off",
    "next-cache-components-optimizer": "off",
    "next-dev-loop": "off",
    "next-partial-prefetching-adoption": "off",
    "clerk-nextjs-patterns": "off"
  },
  "permissions": {
    "deny": [
      "Bash(python3 .workflow/approve-gate.py:*)",
      "Bash(python .workflow/approve-gate.py:*)",
      "Bash(./.workflow/approve-gate.py:*)",
      "Bash(.workflow/approve-gate.py:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.workflow/hooks/next-phase.py\"",
            "timeout": 10,
            "statusMessage": "Checking whether the next workflow phase starts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.workflow/hooks/check-model.py\"",
            "timeout": 10,
            "statusMessage": "Checking the session model against the phase routing"
          }
        ]
      }
    ]
  }
}
