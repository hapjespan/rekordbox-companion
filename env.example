# Copy to .env and fill in. Never commit .env.
# The database role is this project's own, not the Postgres superuser: one role
# per project, owning one database, so a leak here cannot reach another project.
DATABASE_URL=postgresql://rekordbox-companion:CHANGE_ME@postgres:5432/rekordbox-companion
REDIS_URL=redis://redis:6379

# Ports published on the host loopback by docker-compose.yml. Give every project
# its own, or two projects cannot run at the same time.
DEV_PORT=3000
VITE_PORT=5173

# Optional: overrides the companion's own SQLite store (default:
# sqlite:///data/app.sqlite). Deliberately not named DATABASE_URL, which is
# reserved above for the central Postgres analytics mirror (unused in v1).
# COMPANION_DATABASE_URL=

# Client id of your OWN Spotify Developer Dashboard app (create one at
# https://developer.spotify.com/dashboard). This is a PUBLIC-client PKCE flow:
# NO client secret is used or stored anywhere in this repo. Register the
# loopback redirect URI http://127.0.0.1:8787/api/auth/spotify/callback on that
# app. The callback redirect URI is derived in code from the fixed 127.0.0.1:8787
# binding, so it needs no env var of its own.
SPOTIFY_CLIENT_ID=
